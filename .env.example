# ==============================================================================
# Taheel AI (تأهيل) Environment Configuration
# ==============================================================================

# Primary LLM Provider: Google Gemini
# Base URL: https://generativelanguage.googleapis.com/v1beta/openai/
GOOGLE_API_KEY=[GCP_API_KEY]
GEMINI_MODEL=gemma-4-31b-it

# Fallback LLM Provider 1: OpenRouter (with specified model)
# Base URL: https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Fallback LLM Provider 2: Mistral AI (Direct API)
# Base URL: https://api.mistral.ai/v1
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-large-latest

# Provider Selection & Fallback Chain (comma-separated order of attempts)
# Options: gemini, openrouter, mistral
PRIMARY_LLM_PROVIDER=gemini
LLM_FALLBACK_CHAIN=openrouter,mistral

# Environment & Server Settings
TAHEEL_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
LOG_LEVEL=INFO
