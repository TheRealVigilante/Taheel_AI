# ==============================================================================
# Taheel AI (تأهيل) Environment Configuration
# ==============================================================================

# Google Gemini API Key (Recommended default for Taheel AI)
# Used with OpenAI-compatible endpoint: https://generativelanguage.googleapis.com/v1beta/openai/
GOOGLE_API_KEY=your_gemini_api_key_here

# Default Gemini Model (e.g., gemini-2.0-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-2.0-flash

# Optional: Direct OpenAI API Key
OPENAI_API_KEY=

# Optional: OpenRouter API Key
OPENROUTER_API_KEY=

# Environment & Server Settings
TAHEEL_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
LOG_LEVEL=INFO
